      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3. Implementação do Algoritmo de Kruskal\n",
        "\n",
        "O Algoritmo de Kruskal exige uma estrutura para gerenciar conjuntos disjuntos (Union-Find) e detectar ciclos eficientemente."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Estrutura de Dados Union-Find (Disjoint Set) com Path Compression e Union by Rank\n",
        "class UnionFind:\n",
        "    def __init__(self, vertices):\n",
        "        self.parent = {v: v for v in vertices}\n",
        "        self.rank = {v: 0 for v in vertices}\n",
        "\n",
        "    def find(self, item):\n",
        "        if self.parent[item] == item:\n",
        "            return item\n",
        "        # Path compression: achata a árvore ligando diretamente à raiz\n",
        "        self.parent[item] = self.find(self.parent[item])\n",
        "        return self.parent[item]\n",
        "\n",
        "    def union(self, root1, root2):\n",
        "        # Union by rank: anexa a árvore menor na raiz da maior\n",
        "        if self.rank[root1] > self.rank[root2]:\n",
        "            self.parent[root2] = root1\n",
        "        elif self.rank[root1] < self.rank[root2]:\n",
        "            self.parent[root1] = root2\n",
        "        else:\n",
        "            self.parent[root2] = root1\n",
        "            self.rank[root1] += 1\n",
        "\n",
        "def algoritmo_kruskal(grafo):\n",
        "    \"\"\"\n",
        "    Calcula a Árvore Geradora Mínima usando Kruskal.\n",
        "    Ideal para planejar o cabeamento magnético de menor custo global.\n",
        "    \"\"\"\n",
        "    mst = []\n",
        "    custo_total = 0\n",
        "    \n",
        "    # 1. Obter todas as arestas e ordená-las por peso (ordem crescente)\n",
        "    arestas = extrair_arestas_unicas(grafo)\n",
        "    arestas.sort(key=lambda item: item[0])\n",
        "    \n",
        "    # 2. Inicializar a estrutura Union-Find com todos os vértices\n",
        "    uf = UnionFind(grafo.keys())\n",
        "    \n",
        "    # 3. Iterar sobre as arestas ordenadas\n",
        "    for peso, origem, destino in arestas:\n",
        "        raiz_origem = uf.find(origem)\n",
        "        raiz_destino = uf.find(destino)\n",
        "        \n",
        "        # Se as raízes são diferentes, a aresta não forma ciclo\n",
        "        if raiz_origem != raiz_destino:\n",
        "            uf.union(raiz_origem, raiz_destino)\n",
        "            mst.append((origem, destino, peso))\n",
        "            custo_total += peso\n",
        "            \n",
        "            # Otimização: A MST de um grafo conexo com V vértices tem V-1 arestas\n",
        "            if len(mst) == len(grafo) - 1:\n",
        "                break\n",
        "                \n",
        "    return mst, custo_total\n",
        "\n",
        "# Execução de Kruskal na Malha\n",
        "mst_kruskal, custo_kruskal = algoritmo_kruskal(malha_agv)\n",
        "\n",
        "print(\"--- RESULTADO KRUSKAL ---\")\n",
        "print(f\"Custo total da infraestrutura: {custo_kruskal} metros\")\n",
        "print(\"Corredores Selecionados (Origem, Destino, Metros):\")\n",
        "for corredor in mst_kruskal:\n",
        "    print(f\"  {corredor[0]} <---> {corredor[1]} (Custo: {corredor[2]})\")\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 4. Implementação do Algoritmo de Prim\n",
        "\n",
        "O Algoritmo de Prim cresce a árvore a partir de um nó central (ex: Estação de Recarga Base). Utilizaremos uma fila de prioridade (`min-heap`) para extrair sempre a aresta de menor custo que conecta a malha existente a um novo nó."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 3,
      "metadata": {},
      "outputs": [],
      "source": [
        "def algoritmo_prim(grafo, no_inicial):\n",
        "    \"\"\"\n",
        "    Calcula a Árvore Geradora Mínima usando Prim.\n",
        "    Simula a expansão da rede de comunicação a partir de um ponto central.\n",
        "    \"\"\"\n",
        "    mst = []\n",
        "    custo_total = 0\n",
        "    \n",
        "    # Conjunto para rastrear nós já inclusos na árvore\n",
        "    visitados = set([no_inicial])\n",
        "    \n",
        "    # Min-heap (fila de prioridade) armazenando (peso, origem, destino)\n",
        "    arestas_borda = []\n",
        "    \n",
        "    # Inicializa a fronteira com os vizinhos do nó inicial\n",
        "    for vizinho, peso in grafo[no_inicial].items():\n",
        "        heapq.heappush(arestas_borda, (peso, no_inicial, vizinho))\n",
        "        \n",
        "    # Enquanto a árvore não incluir todos os nós e a fronteira não estiver vazia\n",
        "    while arestas_borda and len(visitados) < len(grafo):\n",
        "        # Extrai a aresta mais barata da fronteira\n",
        "        peso, origem, destino = heapq.heappop(arestas_borda)\n",
        "        \n",
        "        # Se o destino ainda não está na árvore (evita ciclos)\n",
        "        if destino not in visitados:\n",
        "            visitados.add(destino)\n",
        "            mst.append((origem, destino, peso))\n",
        "            custo_total += peso\n",
        "            \n",
        "            # Adiciona os novos corredores vizinhos do destino à fronteira\n",
        "            for novo_vizinho, novo_peso in grafo[destino].items():\n",
        "                if novo_vizinho not in visitados:\n",
        "                    heapq.heappush(arestas_borda, (novo_peso, destino, novo_vizinho))\n",
        "                    \n",
        "    return mst, custo_total\n",
        "\n",
        "# Execução de Prim a partir da Estação Base\n",
        "no_partida = 'ST-01_Base'\n",
        "mst_prim, custo_prim = algoritmo_prim(malha_agv, no_partida)\n",
        "\n",
        "print(\"--- RESULTADO PRIM ---\")\n",
        "print(f\"Expansão iniciada a partir de: {no_partida}\")\n",
        "print(f\"Custo total da infraestrutura: {custo_prim} metros\")\n",
        "print(\"Corredores Selecionados (Expansão Passo a Passo):\")\n",
        "for passo, corredor in enumerate(mst_prim, 1):\n",
        "    print(f\"  Passo {passo}: {corredor[0]} ---> {corredor[1]} (Custo: {corredor[2]})\")\n"
      ]
    },
