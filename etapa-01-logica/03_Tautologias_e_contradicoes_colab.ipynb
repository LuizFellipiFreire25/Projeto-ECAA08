   "source": [
    "# Teste da Lógica — AGV (Tautologias e Contradições)\n",
    "\n",
    "Este notebook foi criado para validar as fórmulas lógicas descritas no arquivo `03 - Tautologias_e_contradicoes.md` dentro da pasta `etapa-01-logica`. Ele: \n",
    "\n",
    "- Modela as variáveis proposicionais (sensores e atuadores).\n",
    "- Constrói as fórmulas: condição de falha F, intertravamentos, permissivos e regras do controlador.\n",
    "- Verifica, por meio de SAT e enumeração (tabela-verdade), se o estado de risco S_risco = (F ∧ m1) é possível quando as regras estão em vigor.\n",
    "\n",
    "Execute todas as células no Google Colab (Runtime -> Run all) para ver os resultados." 
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Instalação (SymPy já costuma estar disponível no Colab)\n",
    "# !pip install sympy"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from itertools import product\n",
    "from sympy import symbols, Or, And, Not, Implies, satisfiable, simplify_logic\n",
    "\n",
    "# Declarar símbolos lógicos\n",
    "s1, b1, g1, c1, d1, m1, a1, l1 = symbols('s1 b1 g1 c1 d1 m1 a1 l1')\n",
    "\n",
    "# Fórmula F: condição de Falha Crítica / Trip\n",
    "F = Or(s1, b1, g1)\n",
    "\n",
    "# Intertravamento Shutdown: F -> (¬m1 ∧ ¬a1 ∧ l1)\n",
    "shutdown_rule = Implies(F, And(Not(m1), Not(a1), l1))\n",
    "\n",
    "# Permissivo de movimento: P_mov = c1 ∧ ¬d1 ∧ ¬F\n",
    "P_mov = And(c1, Not(d1), Not(F))\n",
    "\n",
    "# Regra operacional: m1 -> P_mov\n",
    "rule_m1_to_Pmov = Implies(m1, P_mov)\n",
    "\n",
    "# Proteção do braço: a1 -> ¬m1\n",
    "arm_rule = Implies(a1, Not(m1))\n",
    "\n",
    "# Regra do controlador (usada na prova): m1 -> ¬F\n",
    "controller_rule = Implies(m1, Not(F))\n",
    "\n",
    "# Estado de risco S_risco = F ∧ m1\n",
    "S_risco = And(F, m1)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Função auxiliar para checagem SAT\n",
    "def check_satisfiable(expr):\n",
    "    sat = satisfiable(expr, algorithm='dpll')\n",
    "    return sat\n",
    "\n",
    "print('Verificando satisfatibilidade com SymPy:\n')\n",
    "expr1 = And(S_risco, controller_rule)\n",
    "sat1 = check_satisfiable(expr1)\n",
    "print('1) S_risco ∧ (m1 -> ¬F):')\n",
    "print('   satisfiable? ->', bool(sat1))\n",
    "if sat1:\n",
    "    print('   exemplo de modelo que satisfaz:', sat1)\n",
    "else:\n",
    "    print('   não há atribuição que satisfaça (insatisfatível)\n')\n",
    "\n",
    "expr2 = And(S_risco, shutdown_rule)\n",
    "sat2 = check_satisfiable(expr2)\n",
    "print('2) S_risco ∧ (F -> (¬m1 ∧ ¬a1 ∧ l1)):')\n",
    "print('   satisfiable? ->', bool(sat2))\n",
    "if sat2:\n",
    "    print('   exemplo de modelo que satisfaz:', sat2)\n",
    "else:\n",
    "    print('   não há atribuição que satisfaça (insatisfatível)\n')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Enumeração por tabela-verdade para encontrar estados onde S_risco é verdadeiro\n",
    "vars_list = ['s1','b1','g1','c1','d1','m1','a1','l1']\n",
    "def eval_F(assign):\n",
    "    return assign['s1'] or assign['b1'] or assign['g1']\n",
    "\n",
    "def eval_Pmov(assign):\n",
    "    return assign['c1'] and (not assign['d1']) and (not eval_F(assign))\n",
    "\n",
    "def satisfies_shutdown(assign):\n",
    "    Fval = eval_F(assign)\n",
    "    return (not Fval) or ((not assign['m1']) and (not assign['a1']) and assign['l1'])\n",
    "\n",
    "def satisfies_controller(assign):\n",
    "    return (not assign['m1']) or (not eval_F(assign))\n",
    "\n",
    "def satisfies_m1_to_pmov(assign):\n",
    "    return (not assign['m1']) or eval_Pmov(assign)\n",
    "\n",
    "def satisfies_arm_rule(assign):\n",
    "    return (not assign['a1']) or (not assign['m1'])\n",
    "\n",
    "risky_states = []\n",
    "for bits in product([False, True], repeat=len(vars_list)):\n",
    "    assign = dict(zip(vars_list, bits))\n",
    "    Fval = eval_F(assign)\n",
    "    if Fval and assign['m1']:\n",
    "        risk_info = {\n",
    "            'assign': assign,\n",
    "            'satisfies_controller': satisfies_controller(assign),\n",
    "            'satisfies_shutdown': satisfies_shutdown(assign),\n",
    "            'satisfies_m1_to_pmov': satisfies_m1_to_pmov(assign),\n",
    "            'satisfies_arm_rule': satisfies_arm_rule(assign),\n",
    "        }\n",
    "        risky_states.append(risk_info)\n",
    "\n",
    "print(f'Estados (completos) onde S_risco = F ∧ m1 é verdadeiro: {len(risky_states)}\n')\n",
    "for i,r in enumerate(risky_states,1):\n",
    "    print(f'Estado {i}:')\n",
    "    print('  atribuições:', r['assign'])\n",
    "    print('  satisfaz controller_rule (m1->¬F)?', r['satisfies_controller'])\n",
    "    print('  satisfaz shutdown_rule (F->(¬m1∧¬a1∧l1))?', r['satisfies_shutdown'])\n",
    "    print('  satisfaz m1->P_mov?', r['satisfies_m1_to_pmov'])\n",
    "    print('  satisfaz a1->¬m1?', r['satisfies_arm_rule'])\n",
    "    print()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Sumário automático\n",
    "print('Resumo (automático):')\n",
    "print('- Número de estados com S_risco (F ∧ m1):', len(risky_states))\n",
    "print('- SymPy: S_risco ∧ (m1 -> ¬F) satisfatível?', bool(sat1))\n",
    "print('- SymPy: S_risco ∧ (F -> (¬m1 ∧ ¬a1 ∧ l1)) satisfatível?', bool(sat2))\n",
    "print()\n",
    "print('Conclusão: As regras "m1 -> ¬F" ou "F -> (¬m1 ∧ ¬a1 ∧ l1)" tornam o estado de risco insatisfatível quando impostas.')\n",
    "\n",
    "# Experimentos extras sugeridos:\n",
    "# - Aplicar múltiplas regras ao mesmo tempo e checar satisfatibilidade global.\n",
    "# - Usar simplify_logic para inspecionar formas normais.\n",
    "# - Integrar com Z3 para provas mais fortes se desejar.\n"
   ]
  }
